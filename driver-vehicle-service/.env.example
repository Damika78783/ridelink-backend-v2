# MongoDB connection string for Driver & Vehicle Service
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ixolwe4.mongodb.net/ridelink_driver_db?appName=Cluster0

# Toggle JWT security enforcement (true for production, false for local dev/demo)
JWT_SECURITY_ENABLED=false

# Optional JWT signing secret (minimum 256 bits)
JWT_SECRET=RideLinkSuperSecretKeyForSigningTokensMustBeAtLeast256BitsLong!

# Server port
SERVER_PORT=8082
